{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@khai93/fabric-core": ["packages/core/src/index.ts"],
      "@khai93/fabric-mcp": ["packages/mcp/src/index.ts"],
      "@khai93/fabric-mcp/server": ["packages/mcp/src/server.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "packages/**/*.d.ts"]
}
